# Base de datos (Postgres del servidor casero, vía proxy WebSocket protegido por Cloudflare Access).
# El host dentro de la URL es `pg-wishlist` (destino que el proxy permite), NO db.cristiansuarez.me.
DATABASE_URL=postgres://wishlist:<CONTRASEÑA>@pg-wishlist:5432/wishlist
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Firma de la cookie de sesión (mínimo 32 caracteres aleatorios): openssl rand -base64 48
SESSION_SECRET=

# Solo para migraciones desde la Mac, por túnel SSH (ssh -N -L 5433:localhost:5432 servidor).
# NUNCA se carga en Vercel.
MIGRATE_DATABASE_URL=postgresql://wishlist:<CONTRASEÑA>@localhost:5433/wishlist
